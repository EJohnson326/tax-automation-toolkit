# Straight-line depreciation toolkit
# Accepts multiple assets interactively, validates each one, and handles bad input gracefully.

def calculate_depreciation(cost, salvage, life):
    """Returns annual straight-line depreciation, or an error message if inputs are invalid."""
    if life <= 0:
        return "Useful life must be greater than zero."
    if cost < 0 or salvage < 0:
        return "Cost and salvage value cannot be negative."
    if salvage > cost:
        return "Salvage value cannot exceed asset cost."
    return (cost - salvage) / life


def get_asset_input():
    """Prompts for one asset's details. Returns a dict, or None if the user is done."""
    name = input("\nAsset name (or press Enter to finish): ")
    if name == "":
        return None

    try:
        cost = float(input("  Asset cost: "))
        salvage = float(input("  Salvage value: "))
        life = float(input("  Useful life (years): "))
    except ValueError:
        print("  That's not a valid number. Skipping this asset.")
        return get_asset_input()

    return {"name": name, "cost": cost, "salvage": salvage, "life": life}


assets = []
while True:
    asset = get_asset_input()
    if asset is None:
        break
    assets.append(asset)

print("\n--- Depreciation Results ---")
for asset in assets:
    result = calculate_depreciation(asset["cost"], asset["salvage"], asset["life"])
    print(asset["name"], "->", result)
